{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "ignorePatterns": [
    "node_modules/",
    "coverage/"
  ],
  "rules": {
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_id", "__dirname", "__filename"]
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": ["log", "error"]
      }
    ]
  }
}
